# Environment for docker-compose.teams.yml. Copy to docker/.env and fill in.
# Never commit the filled-in copy.

# Public HTTPS origin served by the Cloudflare tunnel (no trailing slash).
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com

# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Generate each once with `openssl rand -hex 32` and keep them stable.
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# At least one model provider key for your agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to true after you have signed up and claimed the board.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Optional
# PAPERCLIP_PORT=3100
# PAPERCLIP_DATA_DIR=../data/docker-paperclip
# PAPERCLIP_CHAT_WEBHOOK_PUBLIC_URL=https://chat-ingress.example.com
